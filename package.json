{
  "name": "@local/dsh-theme-suoming",
  "version": "3.5.0",
  "private": true,
  "description": "锁暝主题：鸣潮红黑金完整皮肤（四层场景、机关伞/锁链/导电动态、角色状态与台词、液态玻璃），入口位于 设置 → 通用 / 外观。",
  "icon": "icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/ai-generated-assets.md",
    "docs/third-party-assets-audit.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
